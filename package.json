{
  "name": "woodworkingshop",
  "version": "3.18.0",
  "description": "Browser-based woodworking cabinet planner — parametric design, MaxRects cut-sheet optimizer, PDF/DXF/G-code export, 6-view SVG preview, bilingual EN+HE, PWA offline",
  "keywords": [
    "woodworking",
    "cabinet-design",
    "cut-optimizer",
    "furniture-planner",
    "react",
    "typescript",
    "pwa",
    "pdf-export",
    "dxf-export",
    "gcode",
    "bin-packing",
    "maxrects",
    "tailwindcss",
    "zustand",
    "vite",
    "bilingual",
    "hebrew",
    "rtl",
    "woodworking-tools",
    "cabinet-maker"
  ],
  "homepage": "https://rajwanyair.github.io/WoodworkingShop/",
  "repository": {
    "type": "git",
    "url": "https://github.com/RajwanYair/WoodworkingShop.git"
  },
  "bugs": {
    "url": "https://github.com/RajwanYair/WoodworkingShop/issues"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/sync-sw-version.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "check": "npm run typecheck && npm run lint && npm run lint:md && npm run format:check && npm run test",
    "ci": "npm run check && npm run build && npm run bundle:check",
    "i18n:coverage": "node scripts/i18n-coverage.js",
    "bundle:report": "node scripts/bundle-report.js",
    "bundle:check": "node scripts/bundle-report.js",
    "lighthouse": "npx --yes @lhci/cli@0.14.x autorun --config=config/lighthouserc.json",
    "lint:md": "markdownlint-cli2 \"*.md\" \"docs/**/*.md\" \".github/**/*.md\"",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium firefox"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.0.0",
    "i18next": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.19",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "markdownlint-cli2": "^0.22.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.0"
  }
}
