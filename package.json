{
  "name": "woodworkingshop",
  "version": "5.34.0",
  "description": "Free browser-based woodworking design app for cabinets and furniture, with cut-list optimization, CNC exports, and offline support",
  "keywords": [
    "woodworking",
    "cabinet-design",
    "cut-list-optimizer",
    "furniture-planner",
    "cnc-router",
    "cut-list",
    "sheet-nesting",
    "maxrects",
    "cabinet-maker",
    "dxf-export",
    "gcode",
    "bill-of-materials",
    "woodworking-tools",
    "furniture-design",
    "browser-based",
    "pwa",
    "multilingual",
    "hebrew",
    "rtl",
    "open-source"
  ],
  "homepage": "https://rajwanyair.github.io/WoodworkingShop/",
  "repository": {
    "type": "git",
    "url": "https://github.com/RajwanYair/WoodworkingShop.git"
  },
  "bugs": {
    "url": "https://github.com/RajwanYair/WoodworkingShop/issues"
  },
  "type": "module",
  "private": true,
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "not dead",
    "not ie 11",
    "not ie_mob 11"
  ],
  "overrides": {
    "eslint": "$eslint",
    "table": {
      "ajv": "^8.18.0"
    },
    "workbox-build": {
      "ajv": "^8.18.0"
    },
    "markdownlint-cli2": {
      "smol-toml": "^1.8.0"
    },
    "eslint-plugin-react": {
      "eslint": "*"
    }
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/sync-sw-version.js",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/capability-map.js",
    "prebuild:nocheck": "node scripts/sync-sw-version.js",
    "build:nocheck": "vite build",
    "preview": "vite preview",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:components": "vitest run --config vitest.components.config.ts --coverage",
    "test:coverage:map": "npm run test:coverage && npm run test:coverage:components && node scripts/test-coverage-map.js",
    "test:coverage:ratchet": "npm run test:coverage && npm run test:coverage:components && node scripts/coverage-ratchet.js",
    "test:coverage:ratchet:update": "npm run test:coverage && npm run test:coverage:components && node scripts/coverage-ratchet.js --update",
    "lint": "node scripts/lint.js",
    "lint:css": "node scripts/lint-css.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "quality": "npm run typecheck && npm run lint && npm run lint:css && npm run lint:md && npm run format:check && npm run i18n:coverage && npm run agents:validate && npm run prompts:validate && npm run instructions:validate && npm run vscode:extensions:validate && npm run mcp:metadata:validate && npm run ai:context:validate && npm run workflows:validate && npm run hooks:validate && npm run template:sync:validate && npm run pdf:budget && npm run components:budget",
    "quality:fast": "node scripts/parallel-quality.js",
    "capabilities:check": "node scripts/capability-map.js",
    "check": "npm run quality:fast && npm run test",
    "ci": "npm run check && npm run build && npm run bundle:check && npm run bench:check",
    "release:build": "npm run build && npm run bundle:check && npm run sbom",
    "agents:validate": "node scripts/validate-agent-contracts.js",
    "prompts:validate": "node scripts/validate-prompt-contracts.js",
    "instructions:validate": "node scripts/validate-instruction-frontmatter.js",
    "vscode:extensions:validate": "node scripts/validate-vscode-extensions-policy.js",
    "mcp:metadata:validate": "node scripts/validate-mcp-metadata.js",
    "ai:context:validate": "node scripts/validate-ai-context-versions.js",
    "workflows:validate": "node scripts/validate-workflow-governance.js",
    "hooks:validate": "node scripts/validate-hook-governance.js",
    "template:sync:validate": "node scripts/validate-template-sync-manifest.js",
    "template:sync": "node scripts/sync-template-assets.js",
    "template:sync:diff": "node scripts/diff-template-assets.js",
    "exports:golden:update": "node scripts/update-export-golden-baseline.js",
    "exports:golden:check": "vitest run tests/utils/export-golden-baseline.test.ts",
    "i18n:coverage": "node scripts/i18n-coverage.js",
    "i18n:completeness": "node scripts/i18n-completeness.js",
    "bundle:check": "node scripts/bundle-report.js",
    "lighthouse": "node scripts/lighthouse.js",
    "mcp:validate": "node scripts/validate-mcp-governance.js",
    "docs:freshness": "node scripts/check-docs-freshness.js",
    "lint:md": "markdownlint-cli2 \"*.md\" \"docs/**/*.md\" \".github/**/*.md\"",
    "components:budget": "node scripts/check-component-budgets.js",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium firefox",
    "test:mutation": "stryker run",
    "bench": "vitest bench",
    "bench:check": "node scripts/bench-check.js",
    "bench:update": "node scripts/bench-check.js --update",
    "test:summary": "node scripts/vitest-reporter.js",
    "pdf:budget": "vitest run tests/utils/pdf-rendering-budget.test.tsx",
    "lint:summary": "node scripts/lint-summary.js",
    "docs:api": "typedoc",
    "dead:check": "knip",
    "sbom": "node scripts/sbom.js",
    "validate:commitmsg": "node scripts/validate-commit-msg.js",
    "prepare": "npx simple-git-hooks"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "knip": {
    "entry": [
      "src/engine/index.ts!",
      "src/engine/assembly/index.ts!",
      "src/engine/export/index.ts!",
      "src/engine/geometry/index.ts!",
      "src/engine/hardware/index.ts!",
      "src/engine/materials/index.ts!",
      "src/engine/optimizer/index.ts!",
      "src/i18n/index.ts!",
      "src/workers/**/*.worker.ts",
      "tests/bench/**/*.bench.ts",
      "src/components/layout/Icons.tsx!",
      "src/utils/audit-log.ts!",
      "src/utils/indexed-db-storage.ts!",
      "src/utils/plugin-marketplace.ts!",
      "src/utils/project-branching.ts!",
      "src/utils/ar-placement.ts!",
      "src/utils/batch-export-runner.ts!",
      "src/utils/cost-comparison.ts!",
      "src/utils/erp-export-download.ts!",
      "src/utils/export-presets.ts!",
      "src/utils/webserial-cnc.ts!",
      "tests/helpers.ts!"
    ],
    "project": [
      "src/**/*.{ts,tsx}",
      "tests/**/*.{ts,tsx}",
      "scripts/**/*.js"
    ],
    "ignore": [
      "src/env.d.ts"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "node scripts/validate-commit-msg.js $1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings 0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.{json,yaml,yml}": "prettier --write",
    "*.md": "markdownlint-cli2 --fix",
    "*.css": "stylelint --fix"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "comlink": "4.4.2",
    "i18next": "^26.4.2",
    "idb-keyval": "6.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.13",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-only-tests": "3.4.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-testing-library": "7.16.2",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "fflate": "0.8.2",
    "jsdom": "^29.1.1",
    "knip": "6.38.0",
    "lint-staged": "^17.5.1",
    "markdownlint-cli2": "^0.23.3",
    "pdfjs-dist": "4.10.38",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.14.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwindcss": "^4.3.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^4.1.10"
  }
}
