# npm configuration for WoodworkingShop
#
# legacy-peer-deps: resolves the known peer-dep incompatibility between
# eslint-plugin-react@7.37.5 (peer: "eslint ^3..^9.7") and the project's
# eslint@10.x.  eslint-plugin-react works correctly at runtime with ESLint 10;
# the peer range in its package.json simply hasn't been updated yet.
# The project's package.json#overrides block adds "eslint-plugin-react/eslint:*"
# as a belt-and-suspenders override, but npm strict-peer resolution still rejects
# it during `npm ci` without this flag.
legacy-peer-deps=true
