{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capability Ledger",
  "type": "object",
  "required": ["version", "modules"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "status"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "pattern": "^src/(engine|utils|services)/.+\\.(ts|tsx|js|jsx)$" },
          "status": { "enum": ["surfaced", "internal", "public-api", "surface-next", "retire"] },
          "reason": { "type": "string", "minLength": 1 },
          "documentedIn": { "enum": ["docs/API-BOUNDARIES.md", "docs/PLUGIN-API.md"] },
          "targetSprint": { "type": "integer", "minimum": 1 },
          "targetRelease": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "internal" } } },
            "then": { "required": ["reason"] }
          },
          {
            "if": { "properties": { "status": { "const": "public-api" } } },
            "then": { "required": ["documentedIn"] }
          },
          {
            "if": { "properties": { "status": { "const": "surface-next" } } },
            "then": { "required": ["targetSprint", "reason"] }
          },
          {
            "if": { "properties": { "status": { "const": "retire" } } },
            "then": { "required": ["targetRelease", "reason"] }
          }
        ]
      }
    }
  }
}
