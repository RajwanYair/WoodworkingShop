{
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "not dead",
    "not ie 11",
    "not ie_mob 11"
  ],
  "hints": {
    "compat-api/css": [
      "error",
      {
        "ignore": [
          "forced-color-adjust",
          "scrollbar-width",
          "print-color-adjust",
          "color-scheme",
          "orphans",
          "widows",
          "outline",
          "outline-offset",
          "page",
          "fill",
          "stroke",
          "::-webkit-scrollbar",
          ":focus-visible"
        ]
      }
    ],
    "compat-api/html": [
      "error",
      {
        "ignore": ["meta[name=theme-color]"]
      }
    ],
    "no-inline-styles": "off",
    "axe/aria": "off"
  }
}
