{
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "not dead",
    "not ie 11",
    "not ie_mob 11"
  ],
  "ignoredUrls": [
    "dist/**",
    "node_modules/**",
    "coverage/**"
  ],
  "hints": {
    "compat-api/css": "off",
    "compat-api/html": "off",
    "compat-api/js": "off",
    "no-inline-styles": "off",
    "axe/aria": "error"
  }
}
