# Cloudflare Pages _headers — security and reporting headers applied at the CDN edge.
# Reference: https://developers.cloudflare.com/pages/configuration/headers/
#
# Phase 12 / Sprint 16 — CSP report-to endpoint wired to a companion Cloudflare Worker.
#
# To swap the reporting endpoint:
#   Report URI free tier : https://<org>.report-uri.com/r/d/csp/enforce
#   Sentry               : https://o<id>.ingest.sentry.io/api/<proj>/security/?sentry_key=<key>
#   Custom Worker        : https://csp.cabinet-planner.workers.dev/report  ← default below
#
# Note: <meta http-equiv="Content-Security-Policy"> in index.html acts as a fallback
# for environments that do not honour HTTP headers (e.g. file:// previews).  The HTTP
# header defined here takes precedence on Cloudflare Pages and supports report-to /
# report-uri which the <meta> tag cannot deliver.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 0
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), serial=(), hid=()
  Report-To: {"group":"csp-violations","max_age":86400,"endpoints":[{"url":"https://csp.cabinet-planner.workers.dev/report"}]}
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' blob: https://cdnjs.cloudflare.com https://cloudflareinsights.com https://csp.cabinet-planner.workers.dev; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests; report-to csp-violations; report-uri https://csp.cabinet-planner.workers.dev/report
