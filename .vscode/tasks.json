{
  "version": "2.0.0",
  "tasks": [
    // ─── Build ────────────────────────────────────────────────────────────────
    {
      "label": "Typecheck",
      "type": "npm",
      "script": "typecheck",
      "group": "build",
      "detail": "Run tsc --noEmit to type-check without emitting files",
      "problemMatcher": ["$tsc"],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "Build",
      "type": "npm",
      "script": "build",
      "group": { "kind": "build", "isDefault": true },
      "detail": "Production build via Vite/Rolldown → dist/",
      "problemMatcher": ["$tsc"],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Dev Server",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": [
        {
          "owner": "vite",
          "pattern": { "regexp": "^(NOMATCH)$", "message": 1 },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^.*vite.*",
            "endsPattern": "Local:.*http://localhost"
          }
        }
      ]
    },

    // ─── Quality ──────────────────────────────────────────────────────────────
    {
      "label": "Lint",
      "type": "npm",
      "script": "lint",
      "detail": "ESLint flat config — 7 plugins, --max-warnings 0",
      "problemMatcher": ["$eslint-stylish"],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "Lint CSS",
      "type": "npm",
      "script": "lint:css",
      "detail": "Stylelint — validates Tailwind v4 CSS patterns",
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "Lint Markdown",
      "type": "npm",
      "script": "lint:md",
      "detail": "markdownlint-cli2 on all .md files",
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "Format",
      "type": "npm",
      "script": "format",
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "Format Check",
      "type": "npm",
      "script": "format:check",
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "Quality (no tests)",
      "type": "npm",
      "script": "quality",
      "group": "build",
      "detail": "typecheck + lint + lint:css + lint:md + format:check + i18n:coverage (parallel)",
      "problemMatcher": ["$tsc", "$eslint-stylish"],
      "presentation": { "reveal": "always", "panel": "shared" }
    },

    // ─── Tests ────────────────────────────────────────────────────────────────
    {
      "label": "Test",
      "type": "npm",
      "script": "test",
      "group": { "kind": "test", "isDefault": true },
      "detail": "Vitest unit tests (engine + store + utils + hooks)",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Test Coverage",
      "type": "npm",
      "script": "test:coverage",
      "group": "test",
      "detail": "Vitest with lcov coverage → $TEMP/WoodworkingShop/coverage/",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Test Watch",
      "type": "npm",
      "script": "test:watch",
      "group": "test",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Test E2E",
      "type": "npm",
      "script": "test:e2e",
      "group": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Bench Check",
      "type": "npm",
      "script": "bench:check",
      "group": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },

    // ─── Gates ────────────────────────────────────────────────────────────────
    {
      "label": "Check (full quality gate)",
      "type": "npm",
      "script": "check",
      "group": "build",
      "detail": "quality:fast + npm test — full pre-commit gate",
      "problemMatcher": ["$tsc", "$eslint-stylish"],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "CI (full)",
      "type": "npm",
      "script": "ci",
      "group": "build",
      "detail": "check + build + bundle:check + bench:check — mirrors GitHub Actions",
      "problemMatcher": ["$tsc", "$eslint-stylish"],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Release Build",
      "type": "npm",
      "script": "release:build",
      "group": "build",
      "detail": "build + bundle:check + sbom (run after npm run check)",
      "problemMatcher": ["$tsc"],
      "presentation": { "reveal": "always", "panel": "shared" }
    },

    // ─── Audit & Analysis ─────────────────────────────────────────────────────
    {
      "label": "i18n Coverage",
      "type": "npm",
      "script": "i18n:coverage",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Bundle Check",
      "type": "npm",
      "script": "bundle:check",
      "group": "build",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Dead code",
      "type": "npm",
      "script": "dead:check",
      "group": "build",
      "detail": "Knip — find unused exports, files, and dependencies",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Docs API",
      "type": "npm",
      "script": "docs:api",
      "detail": "TypeDoc — generate API docs to docs/api/",
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "SBOM",
      "type": "npm",
      "script": "sbom",
      "detail": "CycloneDX SBOM — software bill of materials",
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },

    // ─── Maintenance ───────────────────────────────────────────────────────
    {
      "label": "Clean TEMP",
      "type": "shell",
      "command": "Remove-Item -Recurse -Force -ErrorAction SilentlyContinue \"$env:TEMP\\WoodworkingShop\"; Write-Host 'TEMP cleaned.'",
      "options": { "shell": { "executable": "pwsh", "args": ["-NoLogo", "-NonInteractive", "-Command"] } },
      "detail": "Remove $TEMP\\WoodworkingShop — coverage, vite cache, build logs",
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    }
  ]
}
