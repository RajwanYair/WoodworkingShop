{
  "recommendations": [
    // ── Core IDE enhancements ─────────────────────────────────────────────
    "esbenp.prettier-vscode",
    "dbaeumer.vscode-eslint",
    "usernamehw.errorlens",

    // ── TypeScript + React ────────────────────────────────────────────────
    // TypeScript Nightly required for TypeScript 6 language features.
    // Activate it via the "TypeScript: Select TypeScript Version" command
    // and choose "Use Workspace Version" (node_modules/typescript).
    "ms-vscode.vscode-typescript-next",

    // ── Styling ───────────────────────────────────────────────────────────
    // Tailwind v4 IntelliSense — class autocomplete, hover docs, lint.
    // Requires enabling the v4 compatibility mode in VS Code settings.
    "bradlc.vscode-tailwindcss",    // Stylelint — enforces stylelint.config.js rules on src/index.css.
    "stylelint.vscode-stylelint",
    // ── Testing ───────────────────────────────────────────────────────────
    // Vitest test runner — run/debug individual tests in the editor gutter.
    "vitest.explorer",
    // Playwright test runner — run, debug, and trace E2E tests visually.
    "ms-playwright.playwright",

    // ── CI / DevOps ───────────────────────────────────────────────────────
    "github.vscode-github-actions",
    "timonwong.shellcheck",

    // ── GitHub Copilot ────────────────────────────────────────────────
    // Base Copilot extension (inline completions).
    "github.copilot",
    // Copilot Chat panel (requires github.copilot to be installed).
    "github.copilot-chat"
  ]
}
