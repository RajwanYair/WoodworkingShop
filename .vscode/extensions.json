{
  "recommendations": [
    // ── Core IDE enhancements ─────────────────────────────────────────────
    "esbenp.prettier-vscode",
    "dbaeumer.vscode-eslint",
    "usernamehw.errorlens",

    // ── TypeScript + React ────────────────────────────────────────────────
    // TypeScript Nightly required for TypeScript 6 language features.
    // Activate it via the "TypeScript: Select TypeScript Version" command
    // and choose "Use Workspace Version" (node_modules/typescript).
    "ms-vscode.vscode-typescript-next",

    // ── Styling ───────────────────────────────────────────────────────────
    // Tailwind v4 IntelliSense — class autocomplete, hover docs, lint.
    "bradlc.vscode-tailwindcss",
    // Stylelint — enforces stylelint.config.js rules on src/index.css.
    "stylelint.vscode-stylelint",

    // ── Code quality helpers ──────────────────────────────────────────────
    // Spell checker — catches typos in code identifiers, comments, strings.
    "streetsidesoftware.code-spell-checker",
    // Import cost — shows inline bundle sizes of imported packages.
    "wix.vscode-import-cost",

    // ── Testing ───────────────────────────────────────────────────────────
    // Vitest test runner — run/debug individual tests in the editor gutter.
    "vitest.explorer",
    // Playwright test runner — run, debug, and trace E2E tests visually.
    "ms-playwright.playwright",

    // ── CI / DevOps ───────────────────────────────────────────────────────
    "github.vscode-github-actions",
    "timonwong.shellcheck",

    // ── GitHub Copilot ────────────────────────────────────────────────────
    // Core Copilot extension — AI completions and inline suggestions.
    "github.copilot",
    // Copilot Chat panel — requires github.copilot to be installed.
    "github.copilot-chat"
  ]
}
