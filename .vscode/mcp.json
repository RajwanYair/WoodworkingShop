{
  // Secret inputs are prompted once and stored in VS Code secret storage —
  // never committed to disk. Referenced below via ${input:<id>}.
  "inputs": [
    {
      "id": "brave-api-key",
      "type": "promptString",
      "description": "Brave Search API key (https://brave.com/search/api/)",
      "password": true
    }
  ],
  "servers": {
    // ─── GitHub — official Copilot-native MCP (PRs, issues, workflows, code search) ─
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "description": "Official GitHub MCP — pull requests, issues, Actions workflows, and code search in Copilot chat."
    },

    // ─── Filesystem — scoped workspace access ─────────────────────────────
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${workspaceFolder}",
        "--exclude",
        "node_modules,.git,dist,coverage,playwright-report,test-results"
      ],
      "description": "Scoped workspace file system access for reading and editing project files."
    },

    // ─── Fetch — retrieve web docs/APIs directly in chat ─────────────────────
    "fetch": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"],
      "description": "Fetch web pages and API payloads for fact-grounded debugging and research."
    },

    // ─── Playwright — browser automation for E2E debugging in chat ────────
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "description": "Browser automation for E2E debugging and accessibility verification in chat workflows."
    },

    // ─── Memory — persistent agent notes across sessions ──────────────────
    "memory": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "description": "Persistent key-value memory for agent context across sessions."
    },

    // ─── Sequential Thinking — multi-step problem decomposition ──────────
    "sequentialthinking": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "description": "Structured multi-step reasoning for complex problem decomposition."
    },

    // ─── Context7 — up-to-date library docs (React, Vite, Tailwind, etc.) ─
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "description": "Retrieves current, version-accurate documentation for npm packages — prevents hallucinated APIs."
    },

    // ─── GitKraken — advanced git/PR workflow operations ─────────────────────
    "gitkraken": {
      "type": "http",
      "url": "https://mcp.gitkraken.com/mcp",
      "description": "Git operations, commit history analysis, and pull request workflow support."
    },

    // ─── Cloudflare — Workers, Pages, D1, KV, R2 management ──────────────
    "cloudflare": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp",
      "description": "Cloudflare Pages/Workers infrastructure management for deployment and runtime diagnostics."
    },

    // ─── Brave Search — web search fallback for docs not in Context7 ─────
    "brave-search": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "env": {
        "BRAVE_API_KEY": "${input:brave-api-key}"
      },
      "description": "Web search fallback for documentation and references when package docs are not available in Context7."
    }
  }
}
