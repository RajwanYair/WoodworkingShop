{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "eslint.useFlatConfig": true,
  "files.eol": "\n",

  // ─── Terminal / Shell Integration ─────────────────────────────────────────
  // PowerShell has first-class shell integration on Windows (CWD tracking,
  // command decorations, exit-code detection). cmd.exe has no integration
  // support, which is why VS Code shows the "enable shell integration" prompt.
  //
  // `defaultProfile` controls interactive terminals.
  // `automationProfile` controls task / debug / process execution terminals —
  // without it VS Code falls back to cmd.exe, triggering the prompt even when
  // the interactive terminal is already set to PowerShell.
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.shellIntegration.decorationsEnabled": "both",
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.cwd": "${workspaceFolder}",

  // Explicit PowerShell profile — -NoLogo suppresses the banner so VS Code's
  // command-position markers are not confused by extra output lines.
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "source": "PowerShell",
      "icon": "terminal-powershell",
      "args": ["-NoLogo"]
    },
    "Command Prompt": {
      "path": "${env:windir}\\System32\\cmd.exe",
      "icon": "terminal-cmd"
    }
  },

  // Automation profile used by tasks, the debugger, and the test runner.
  // -NoLogo keeps output clean; -NonInteractive prevents prompt/STDIN hangs
  // in headless task runs.
  "terminal.integrated.automationProfile.windows": {
    "name": "PowerShell",
    "source": "PowerShell",
    "args": ["-NoLogo", "-NonInteractive"]
  },

  // CSS/HTML lint: our browserslist excludes IE entirely (see .browserslistrc).
  // Inline styles are required for dynamic runtime values (data-driven colors/widths).
  // ARIA attribute expressions are valid JSX producing correct string values at runtime
  // — the static analyzer cannot evaluate JSX ternaries or boolean props.
  // Progressive enhancement CSS (scrollbar-width, orphans, widows, forced-color-adjust,
  // print-color-adjust, color-scheme, page) is intentional enhancement for supporting
  // browsers — does not degrade for non-supporting browsers.
  //
  // Disabling built-in CSS validation because:
  // 1. Tailwind CSS v4 generates valid modern CSS that the built-in validator doesn't understand.
  // 2. Our .browserslistrc already defines browser targets — Vite/PostCSS handles compat.
  // 3. ESLint + Prettier are our source-of-truth linters for code quality.
  "css.validate": false,
  "css.lint.compatibleVendorPrefixes": "ignore",
  "css.lint.vendorPrefix": "ignore",
  "css.lint.propertyIgnoredDueToDisplay": "ignore",
  "css.lint.unknownProperties": "ignore",

  // Accessibility linting in JSX/TSX: VS Code's static ARIA checker cannot
  // evaluate JSX expressions (`{condition ? 'ascending' : 'none'}`) or
  // verify that `aria-controls` targets exist across component boundaries.
  // Runtime accessibility is verified by axe-core in Playwright E2E tests.
  // Inline styles are required for: zoom transforms, tooltip positioning,
  // data-driven chart colors — values computed at runtime from state.
  "html.validate.scripts": true,
  "html.validate.styles": false,

  "files.exclude": {
    "**/dist/**": true,
    "**/coverage/**": true,
    "**/playwright-report/**": true,
    "**/test-results/**": true
  },
  "search.exclude": {
    "**/dist": true,
    "**/node_modules": true,
    "**/coverage": true
  },

  "[tsx]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[ts]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  }
}
