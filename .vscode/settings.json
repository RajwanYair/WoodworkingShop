{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "eslint.useFlatConfig": true,
  "files.eol": "\n",

  // Built-in CSS validator produces false-positive browser-compat warnings
  // (IE, older Safari) for Tailwind CSS projects. Tailwind IntelliSense
  // extension handles CSS validation instead.
  "css.validate": false,
  "scss.validate": false,

  "files.exclude": {
    "**/dist/**": true,
    "**/coverage/**": true,
    "**/playwright-report/**": true,
    "**/test-results/**": true
  },
  "search.exclude": {
    "**/dist": true,
    "**/node_modules": true,
    "**/coverage": true
  },

  "webhint.ignoreHintedFiles": ["**/dist/**", "**/node_modules/**", "**/coverage/**", "**/playwright-report/**"],

  "html.validate.scripts": true,
  "html.validate.styles": true,

  "[tsx]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[ts]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  }
}
