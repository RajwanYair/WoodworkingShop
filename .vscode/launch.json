{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Chrome (Dev)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173/WoodworkingShop/",
      "webRoot": "${workspaceFolder}/src",
      "preLaunchTask": "Dev Server",
      "sourceMapPathOverrides": {
        "/@fs/*": "${workspaceFolder}/*",
        "/src/*": "${workspaceFolder}/src/*"
      }
    },
    {
      "name": "Debug Vitest (current file)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/../node_modules/vitest/vitest.mjs",
      "args": ["run", "${relativeFile}", "--reporter=verbose"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "smartStep": true,
      "sourceMaps": true,
      "env": {
        "NODE_OPTIONS": "--experimental-vm-modules"
      }
    },
    {
      "name": "Debug Vitest (all tests)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/../node_modules/vitest/vitest.mjs",
      "args": ["run", "--reporter=verbose"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "smartStep": true,
      "sourceMaps": true,
      "env": {
        "NODE_OPTIONS": "--experimental-vm-modules"
      }
    },
    {
      "name": "Debug Playwright (current file)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/../node_modules/.bin/playwright",
      "args": ["test", "${relativeFile}", "--debug"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
